# ============================================================================
# CAMTEL OnePortal — Environment Configuration (.env.example)
# ============================================================================
# Copy this file to .env and fill in with your actual values.
# CRITICAL: Never commit .env to version control (already in .gitignore).
#
# Environment Detection:
#   Development:  DEBUG=True, DJANGO_SETTINGS_MODULE=config.settings.dev
#   Staging/Prod: DEBUG=False, DJANGO_SETTINGS_MODULE=config.settings.prod
#                 SECRET_KEY REQUIRED (app refuses to start if missing/placeholder)
# ============================================================================

# ---- DJANGO CORE SETTINGS ----

# Django debug mode: NEVER True in production (risks SECRET_KEY exposure via error pages)
DEBUG=True

# Django settings module path (determines environment behavior)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Django secret key (production: 50+ random characters via:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
# Production: Blank/placeholder triggers django.core.exceptions.ImproperlyConfigured
SECRET_KEY=change-me-in-production-min-50-chars

# Allowed hosts (CSRF/Host header validation — comma-separated FQDN list)
ALLOWED_HOSTS=localhost,127.0.0.1,camtel.cm,www.camtel.cm

# ---- DATABASE ----

# SQLite (default in dev): Leave DB_HOST/DB_PORT empty to use db.sqlite3
# PostgreSQL (production): Fill DB_* to use postgresql://...
DB_NAME=camtel
DB_USER=camtel
DB_PASSWORD=camtel
DB_HOST=
DB_PORT=5432

# ---- CORS (Cross-Origin Resource Sharing) ----

# Frontend origins allowed to make XHR requests (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Allow all origins (development only; NEVER in production)
CORS_ALLOW_ALL_ORIGINS=True

# ---- JWT AUTHENTICATION & REFRESH TOKENS (SimpleJWT 5.5.1) ----

# Access token lifetime (minutes) — when token expires, client must refresh
JWT_ACCESS_LIFETIME_MINUTES=30

# Refresh token lifetime (days) — cookie persistence; after expiry, must login again
JWT_REFRESH_LIFETIME_DAYS=7

# Refresh token rotation: Issue new refresh token on each refresh, invalidate old one
# Prevents stolen token reuse (RECOMMENDED for security)
REFRESH_TOKEN_ROTATE=True

# Blacklist revoked tokens (prevents reuse of old refresh tokens after rotation/logout)
# Checked on each protected request (CRITICAL for security)
REFRESH_TOKEN_BLACKLIST=True

# Refresh token cookie name (stored in HttpOnly cookie, never localStorage)
REFRESH_COOKIE_NAME=camtel_refresh

# Refresh token cookie: HTTPS only (production requirement; dev can be False)
REFRESH_COOKIE_SECURE=False

# Refresh token cookie: Prevents JavaScript access (XSS protection)
REFRESH_COOKIE_HTTP_ONLY=True

# Refresh token cookie: SameS site policy (CSRF protection)
# Lax: Send in top-level nav from external sites (login flows)
# Strict: Only send in same-origin requests (prevents CSRF)
REFRESH_COOKIE_SAMESITE=Lax

# Refresh token cookie path (only sent to /api/v1/auth/* endpoints)
REFRESH_COOKIE_PATH=/api/v1/auth/

# ---- LOGGING ----

# Log format: 'text', 'json', 'verbose'
LOG_FORMAT=text

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ---- RATE LIMITING (DRF Throttling — see backend/config/settings/base.py) ----

# Anonymous user rate limit (requests per time unit)
THROTTLE_ANON_RATE=60/min

# Authenticated user rate limit
THROTTLE_USER_RATE=600/min

# Partner API rate limit (per API key, not per user)
THROTTLE_PARTNER_RATE=1000/hour

# Fixed throttle rates (hardcoded in settings):
#   - login:   5/min   (brute-force prevention)
#   - register: 3/hour (spam prevention)
#   - auth:    20/min  (token refresh operations)
#   - chatbot: 30/min  (LLM cost control)
#   - search:  120/min (database query protection)
#   - contact: 5/hour  (form submission throttling)

# ---- CHATBOT / LLM CONFIGURATION ----

# Chatbot enabled/disabled
CHATBOT_ENABLED=True

# LLM Provider: 'mock' (test), 'gemini', 'openai', 'ollama', 'none' (fallback FAQ)
CHATBOT_PROVIDER=mock

# LLM Model name (provider-specific)
CHATBOT_MODEL=

# LLM Temperature (0.0=deterministic, 1.0=random)
CHATBOT_TEMPERATURE=0.3

# LLM Max tokens per response (limits cost + latency)
CHATBOT_MAX_TOKENS=512

# Chatbot timeout (seconds) — hard wall-clock limit for LLM generation.
# Prevents hanging requests if provider SDK fails to respect timeout parameter.
# See SECURITY_AUDIT.md section 7: Gemini/gRPC can exceed SDK timeout in edge cases.
CHATBOT_TIMEOUT_SECONDS=20

# Fallback to search if chatbot fails/disabled
CHATBOT_FALLBACK_TO_SEARCH=True

# Chatbot rate limit (0.0 = unlimited)
CHATBOT_RATE_LIMIT=0.0

# Chatbot system prompt (context injected into all LLM requests)
CHATBOT_SYSTEM_PROMPT=Tu es OnePortal AI, l'assistant CAMTEL. Reponds en francais, uniquement a partir du contexte fourni.

# Gemini API Key (required if CHATBOT_PROVIDER=gemini)
# Obtain from: https://ai.google.dev/
GOOGLE_API_KEY=

# OpenAI API Key (required if CHATBOT_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama local endpoint (required if CHATBOT_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ---- PLATFORM SERVICES (V2) ----

# Payment provider: 'mock' | 'orange' | 'mtn' — mock par défaut (dev), orange/mtn en prod avec credentials
PAYMENT_PROVIDER=mock
# Orange Money (ne jamais exposer au frontend — backend uniquement)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_CANCEL_URL=
ORANGE_MONEY_NOTIF_URL=
# MTN Mobile Money Collection
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=
PAYMENT_TIMEOUT_SECONDS=15

# Eligibility checker (subscription pre-qualification)
ELIGIBILITY_PROVIDER=mock

# Email provider: 'console' (stdout), 'smtp', 'sendgrid'
EMAIL_PROVIDER=console

# Default "from" address for transactional emails
DEFAULT_FROM_EMAIL=no-reply@oneportal.local

# Django email backend (if EMAIL_PROVIDER=console, use this for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ---- SMTP / Transactional Email (production) ----
# If you use a real SMTP provider set EMAIL_PROVIDER=smtp and configure the
# following variables. For local testing, run MailHog and point EMAIL_HOST to
# it (default MailHog SMTP port is 1025).
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

# ---- DEMO DATA & DEVELOPMENT ----

# Seed demo data on manage.py migrate (only if DEBUG=True)
# Demo accounts: superadmin/CamtelAdmin2026!, admin/admin123, editor/editor123
# Accounts auto-marked is_demo=True in database (for audit purposes)
# SAFETY: Seed only executes if (DEBUG=True OR SEED_DEMO_DATA=True) AND not already in DB
SEED_DEMO_DATA=True

# ---- SECURITY & HTTPS (Production) ----

# Force HTTPS redirect in production (django.middleware.security.SecurityMiddleware)
SECURE_SSL_REDIRECT=True

# HSTS max age (seconds) — tells browsers to only use HTTPS for future visits
SECURE_HSTS_SECONDS=31536000

# Include subdomains in HSTS policy (*.camtel.cm also HTTPS-only)
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# HSTS preload (submit to browser HSTS preload list)
SECURE_HSTS_PRELOAD=True

# Session cookie security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTP_ONLY=True
SESSION_COOKIE_SAMESITE=Strict

# CSRF cookie security
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTP_ONLY=True
CSRF_COOKIE_SAMESITE=Strict

# Trusted proxy for X-Forwarded-Proto header (if behind reverse proxy/load balancer)
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# ---- INTERNATIONALIZATION (i18n) ----

# Default language code
LANGUAGE_CODE=en-us

# Timezone
TIME_ZONE=UTC

# Supported languages: comma-separated (backend supports 'en', 'fr')
SUPPORTED_LANGUAGES=en,fr

# ---- STORAGE (S3-compatible for production) ----

# Use S3 for media/static files instead of local filesystem
USE_S3_STORAGE=False

# AWS/S3 credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=camtel-media
AWS_S3_REGION_NAME=us-east-1

# Optional: S3-compatible endpoint (DigitalOcean Spaces, MinIO, etc.)
AWS_S3_ENDPOINT_URL=

# Optional: Custom CDN domain for S3 assets
AWS_S3_CUSTOM_DOMAIN=

# ---- FRONTEND (Vite React) ----

# API base URL (relative or absolute)
VITE_API_BASE_URL=/api/v1

# Demo mode flag (disables real API, uses mocks)
VITE_DEMO_MODE=false

# ---- BACKUP & MAINTENANCE ----

# Backup directory for scripts/backup.sh
BACKUP_DIR=./backups

# Media directory path (for backup scripts)
MEDIA_DIR=./backend/media

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================

# Security Pre-Flight:
# ✓ DEBUG=False (disable error pages; SECRET_KEY exposure risk)
# ✓ SECRET_KEY set to 50+ random characters (database validates in prod.py)
# ✓ ALLOWED_HOSTS restricted to actual domain(s) only
# ✓ DATABASE_URL points to PostgreSQL (not SQLite)
# ✓ SECURE_SSL_REDIRECT=True (enforce HTTPS)
# ✓ SECURE_HSTS_SECONDS=31536000 (force HTTPS for 1 year)
# ✓ REFRESH_COOKIE_SECURE=True (HttpOnly cookies over HTTPS only)
# ✓ SESSION_COOKIE_SECURE=True + CSRF_COOKIE_SECURE=True
# ✓ SEED_DEMO_DATA unset or False (prevent demo account injection)
# ✓ EMAIL_BACKEND configured for transactional emails (not console)
# ✓ PAYMENT_PROVIDER set to real provider (not 'mock')
# ✓ Run: python manage.py collectstatic --noinput (prepare static files)
# ✓ Run: python manage.py migrate (apply database migrations)
# ✓ Run: python manage.py check --deploy (Django security checks)
# ✓ Run: pip audit (check for security vulnerabilities in dependencies)

# Architecture Notes:
# - Backend (Django 6.0.7 + DRF 3.17.1): PostgreSQL, RBAC, JWT rotation + blacklist
# - Frontend (React 18 + TypeScript + Vite): Token in memory (access), cookie (refresh)
# - Refresh Token Workflow: LOGIN -> access + refresh cookie -> REFRESH -> new refresh token, old revoked
# - Logout: Refresh token invalidated in database (token_blacklist), frontend clears state
# - Seed Protection: Demo accounts only created if DEBUG=True, marked is_demo=True
# - Rate Limiting: Per-endpoint throttles (5/h login, 30/min chatbot, 120/min search, etc.)

# ============================================================================
# REFERENCES
# ============================================================================

# Settings Module Hierarchy:
#   config/settings/base.py         (shared Django config, SECRET_KEY fallback)
#   config/settings/dev.py          (DEBUG=True, SQLite, allowlist all CORS)
#   config/settings/prod.py         (forces SECRET_KEY validation, HTTPS)

# JWT Documentation:
#   Simple JWT 5.5.1 - https://django-rest-framework-simplejwt.readthedocs.io/
#   Token Rotation + Blacklist - backend/config/settings/base.py SIMPLE_JWT dict

# RBAC (Role-Based Access Control):
#   6 roles: SUPER_ADMIN, ADMIN, PRODUCT_MANAGER, EDITOR, VIEWER, CLIENT
#   Per-endpoint permission checks via apps.core.permissions module

# Chatbot Provider Modules:
#   backend/apps/core/providers.py - LLM abstraction (GeminiProvider, OpenAIProvider, etc.)
#   Lazy import pattern for SDK (Gemini imports google.generativeai in __init__)

# For API documentation:
#   docs/API.md - Comprehensive REST API reference
#   docs/SECURITY.md - Security architecture, authentication flow
#   docs/RBAC.md - Role and permission matrix

