# Variables d'environnement — CAMTEL OnePortal

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (SQLite si DB_HOST vide, PostgreSQL sinon)
DB_NAME=camtel
DB_USER=camtel
DB_PASSWORD=camtel
DB_HOST=
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Logs structurés (text ou json)
LOG_FORMAT=text
LOG_LEVEL=INFO

# Production — HTTPS / HSTS
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Stockage S3-compatible (production)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=camtel-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
VITE_DEMO_MODE=false

# Sauvegarde (scripts/backup.sh)
BACKUP_DIR=./backups
MEDIA_DIR=./backend/media
